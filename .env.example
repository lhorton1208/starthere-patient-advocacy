# Copy to .env and fill in values for local development
SECRET_KEY=change-me-to-a-random-string

# Optional: PostgreSQL connection string (defaults to SQLite in instance/starthere.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/starthere

# Optional: contact details shown on the About and Contacts pages
# CONTACT_INFO_EMAIL=info@startherepatientadvocacy.com
# CONTACT_DAWN_EMAIL=Dawn.Criswell@startherepatientadvocacy.com
# CONTACT_DAWN_PHONE=(555) 123-4568
# CONTACT_GEORGETTE_EMAIL=Georgette.Darnell@startherepatientadvocacy.com
# CONTACT_GEORGETTE_PHONE=(555) 123-4567
# CONTACT_LARRY_EMAIL=Larry.Horton@startherepatientadvocacy.com
# CONTACT_LARRY_PHONE=(555) 123-4569
# CONTACT_LISA_EMAIL=lrldrn@yahoo.com
# CONTACT_LISA_PHONE=(555) 123-4570

# ---------------------------------------------------------------------------
# FHIR / Epic Backend OAuth (SMART Backend Services)
# Register the app on fhir.epic.com as Audience = Backend Systems.
# Prefer private_key_jwt: upload/register your JWK Set URL (PUBLIC_BASE_URL +
# /.well-known/jwks.json). Epic sandbox token + R4 base URLs below.
# ---------------------------------------------------------------------------
# FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# FHIR_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
# FHIR_CLIENT_ID=   # Non-Production Client ID from Epic
# FHIR_SCOPE=system/Patient.read system/Observation.read system/Encounter.read system/Coverage.read system/Procedure.read
# Default sandbox patient for /portal/dashboard (override with ?patient_id=)
# FHIR_PATIENT_ID=erXuFYUfucBZaryVksYEcMg3
# Optional fallback if a vendor issues a client secret instead of JWT:
# FHIR_CLIENT_SECRET=
# Optional pre-issued token (skips token exchange when set):
# FHIR_ACCESS_TOKEN=

# Public site origin used to build the JWKS / JKU URI for Epic registration
# PUBLIC_BASE_URL=https://your-app.onrender.com
# Or set the absolute JWKS URI explicitly:
# PORTAL_JWKS_URI=https://your-app.onrender.com/.well-known/jwks.json

# Portal JWKS + private key (run: python scripts/generate_portal_jwks_keys.py)
# Epic requires DIFFERENT Non-Production vs Production JWK Set URLs.
# After deploy, register:
#   Non-Production: https://www.startherepatientadvocacy.com/.well-known/jwks-nonprod.json
#   Production:     https://www.startherepatientadvocacy.com/.well-known/jwks.json
# (Use the www host — apex redirects and Epic may not follow them.)
# Epic prefers RS384 for Backend OAuth JWTs.
# PORTAL_JWT_KID=
# PORTAL_JWT_ALG=RS384
# PORTAL_JWKS_JSON=
# PORTAL_JWT_PRIVATE_KEY=
# PORTAL_JWT_PRIVATE_KEY_PATH=
# Optional separate non-prod key pair (recommended). If unset, nonprod URL
# temporarily serves the production JWKS so the Epic form can be saved.
# PORTAL_NONPROD_JWT_KID=
# PORTAL_NONPROD_JWT_ALG=RS384
# PORTAL_NONPROD_JWKS_JSON=
# PORTAL_NONPROD_JWT_PRIVATE_KEY=
# PORTAL_NONPROD_JWKS_URI=https://www.startherepatientadvocacy.com/.well-known/jwks-nonprod.json
# FHIR_JWT_ENVIRONMENT=nonprod
